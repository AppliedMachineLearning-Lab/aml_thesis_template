% =============================================================================
%  references.bib
%
%  One entry per work, cited from the text with \textcite{key} or
%  \parencite{key}. Conventions that save pain later:
%
%   * Key format: firstauthorlastname + year + first word of title.
%   * Brace proper nouns and acronyms so the style cannot lowercase them:
%     title = {{BERT}: Pre-training of Deep {B}idirectional Transformers}
%   * Prefer the publisher's / DBLP's BibTeX. Google Scholar's is often wrong
%     about venue, year and author order.
%   * KEEP ENTRIES SHORT: author, title, venue, year. Abbreviate the venue
%     ("Proc. NeurIPS"), and delete pages, publisher, address, editors, month
%     and DOI unless a reader could not find the work without them. Exported
%     BibTeX carries far more than this -- trim it on the way in. See
%     vaswani2017attention below for the shape. Proceedings are "Proc. X";
%     journals are "J. X". A book keeps its publisher, but not the city.
%   * Use @inproceedings for conference papers, @article for journals. Do not
%     cite the arXiv preprint of a paper that was subsequently published.
%   * Keep the file sorted by key so two people editing it collide less.
% =============================================================================

@article{example2020,
  author  = {Doe, Jane and Roe, Richard},
  title   = {An Example Journal Article Used by the Template},
  journal = {J. Example Studies},
  year    = {2020},
}

@inproceedings{example2021,
  author    = {Doe, Jane},
  title     = {An Example Conference Paper},
  booktitle = {Proc. Examples},
  year      = {2021},
}

@book{example2019,
  author    = {Roe, Richard},
  title     = {An Example Book},
  publisher = {Example Press},
  year      = {2019},
}

